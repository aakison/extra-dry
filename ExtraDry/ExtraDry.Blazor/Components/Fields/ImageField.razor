@namespace ExtraDry.Blazor.Components
@using Microsoft.AspNetCore.Components.Forms
@inherits FieldBase<BrowserBlob>

<FieldFrame Size="@Size" Description="@Description" ShowDescription="@ShowDescription" Label="@Label" For="@InputId" ShowLabel="@ShowLabel" IsValid="@IsValid" Message="@ValidationMessage">
    <div class="@CssClasses" @onclick="HandleControlClickAsync">
        <div class="preview-frame">
            <img class="preview" src="@PreviewSrc" alt="@Label" />
        </div>
        <div class="display-and-buttons">
            <div class="@DisplayValueCssClasses" title="@Label">@DisplayValue</div>
            @if(DisplayAffordance) {
                <div class="affordances" @onclick:stopPropagation="true">
                    <label class="affordance-button folder" title="Choose image from files">
                        <Icon CssClass="affordance" Key="@FolderIcon" />
                        <InputFile id="@InputId" class="actual" OnChange="@HandleFileChangeAsync" accept="@Accept" disabled="@ReadOnly" />
                    </label>
                    @if(DisplayCameraAffordance) {
                        <label class="affordance-button camera" title="Take a photo">
                            <Icon CssClass="affordance" Key="@CameraIcon" />
                            <InputFile id="@CameraInputId" class="actual" OnChange="@HandleFileChangeAsync" accept="@Accept" capture="environment" disabled="@ReadOnly" />
                        </label>
                    }
                </div>
            }
        </div>
    </div>
</FieldFrame>
